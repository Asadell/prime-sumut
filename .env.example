# Public variables - Safe to expose to the client/browser
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Private variables - KEEP SECURE AND NEVER EXPOSE TO CLIENT
# Bypasses Row Level Security (RLS)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Email notification (Resend - https://resend.com)
# Daftar di resend.com → API Keys → Create API Key
RESEND_API_KEY=your-resend-api-key
# Email tujuan notifikasi pesan kontak
ADMIN_EMAIL=admin@yourdomain.com
